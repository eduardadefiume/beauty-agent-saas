# Nomes das variáveis, nunca valores. Valor de verdade vive no Vercel (env vars),
# no Supabase (secrets) e nos secrets do GitHub Actions.
#
# Nenhuma das variáveis do projeto Vercel `web` tem alvo Development, então
# `vercel dev` não acha nada: para rodar local, copie este arquivo em
# `.env.local` e preencha.
#
# As cinco variáveis de servidor do apps/web (SUPABASE_SECRET_KEY,
# SUPABASE_CONFIGURATOR_URL, SUPABASE_SCHEDULING_URL e as duas do Google) também
# precisam estar declaradas em `turbo.json` na task `build` — em modo estrito o
# Turborepo filtra o que não está declarado. Variável nova aqui, variável nova lá.

APP_ENV=local
LOG_LEVEL=info

# apps/api
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase — apps/api, apps/worker
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=

# Supabase — apps/web (navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — apps/web (só servidor; a chave secreta ignora RLS)
SUPABASE_SECRET_KEY=
SUPABASE_CONFIGURATOR_URL=
SUPABASE_SCHEDULING_URL=

# Google Agenda — apps/web (Route Handlers) e as edge functions google-agenda*
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
