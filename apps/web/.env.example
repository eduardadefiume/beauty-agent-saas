# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://hjghwryhphgusefyivbl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_UBkq_pKCfezIV3l3D0DA7w_i3PD7ZNW

# Server-only — the Edge Functions this app talks to. Not secrets by
# themselves (each function verifies the caller's own Supabase session JWT),
# but kept server-side so they are not part of the client bundle.
SUPABASE_CONFIGURATOR_URL=https://hjghwryhphgusefyivbl.supabase.co/functions/v1/owner-console-api
SUPABASE_SCHEDULING_URL=https://hjghwryhphgusefyivbl.supabase.co/functions/v1/scheduling-api

# Server-only — SEGREDO DE VERDADE. Ignora RLS; nunca prefixe com NEXT_PUBLIC_
# e nunca importe em Client Component.
#
# Usado por lib/supabase/admin-rpc.ts para chamar `resolve_login_email` nas
# rotas de login e cadastro. Essa RPC converte CPF em e-mail de login, então
# não pode ficar acessível ao papel `anon` (F0-02).
#
# Sem esta variável, entrar por CPF para de funcionar (entrar por e-mail segue
# normal) e o cadastro deixa de checar CPF duplicado antes de submeter.
SUPABASE_SECRET_KEY=
